# ─────────────────────────────────────────────
#  Quiick AI — Environment Variables Template
#  Copy this file: cp .env.example .env
#  Then fill in your actual values
# ─────────────────────────────────────────────

# Django secret key — generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Debug mode — True for dev, False for production
DEBUG=True

# Allowed hosts — comma separated, no spaces
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (default: SQLite — no config needed for dev)
# Uncomment for PostgreSQL in production:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# AI / Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here

# Media & Static
MEDIA_URL=/media/
STATIC_URL=/static/
